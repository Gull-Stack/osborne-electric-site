<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What areas does Osborne Electric serve?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Osborne Electric serves Salt Lake County, Utah County, Davis County, Tooele County, and Summit County. This includes cities like Salt Lake City, Sandy, Draper, Provo, Orem, Lehi, Bountiful, Layton, Tooele, and Park City."
      }
    },
    {
      "@type": "Question",
      "name": "Is Osborne Electric licensed and insured?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Osborne Electric & Contracting is fully licensed by the State of Utah. The company holds Utah DOPL contractor license #12644476-5501, and all electrical work is qualified by Master Electrician Wes Osborne (Utah licence #8528070-5502). The company carries comprehensive liability insurance."
      }
    },
    {
      "@type": "Question",
      "name": "What electrical services does Osborne Electric provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Osborne Electric provides both commercial and residential electrical services. Commercial services include tenant improvements, industrial & warehouse electrical, data & low voltage systems. Residential services include panel upgrades, lighting installation, power restoration and emergency repairs, remodels and new construction wiring, and full home electrical services including outlet repairs, switch installation, rewiring, and home safety inspections."
      }
    },
    {
      "@type": "Question",
      "name": "Does Osborne Electric offer free estimates?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Osborne Electric provides free estimates for all commercial and residential electrical projects across their 5-county service area. Call 801-885-4521 or submit a request through the website contact form."
      }
    },
    {
      "@type": "Question",
      "name": "How do I schedule electrical work with Osborne Electric?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can schedule electrical work by calling 801-885-4521, emailing Osborne-electric@outlook.com, or filling out the contact form on the website. Osborne Electric responds promptly and can typically schedule an assessment within a few days."
      }
    },
    {
      "@type": "Question",
      "name": "What makes Osborne Electric different from other electricians?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Osborne Electric is family-owned by Trevor Osborne, who personally oversees every project. Unlike large companies that send subcontractors, Osborne Electric's own team handles every job with A+ workmanship, honest pricing, and personal accountability."
      }
    },
    {
      "@type": "Question",
      "name": "Does Osborne Electric do commercial work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Osborne Electric handles a full range of commercial electrical projects including office buildouts, retail renovations, restaurant wiring, tenant improvements, and commercial lighting upgrades. Their contractor license and bonding enable them to work on commercial properties throughout Utah."
      }
    },
    {
      "@type": "Question",
      "name": "What types of commercial projects do you handle?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Osborne Electric handles commercial tenant improvements, office buildouts, retail spaces, restaurant electrical systems, industrial facilities, warehouse power distribution, structured cabling and data centers, security system wiring, and commercial lighting retrofits. From small office spaces to large industrial facilities, they scale to your project needs."
      }
    }
  ]
}
</script>
