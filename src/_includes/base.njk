<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description | default('Osborne Electric & Contracting - Utah\'s trusted master electricians serving Salt Lake, Utah, Davis, Tooele & Summit Counties. Licensed electricians for residential electrical services. Call 801-885-4521.') }}">
  <meta name="author" content="Osborne Electric & Contracting">
  <meta name="robots" content="index, follow">

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="shortcut icon" href="/favicon.ico">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title | default('Osborne Electric & Contracting | Utah\'s Trusted Master Electricians') }}">
  <meta property="og:description" content="{{ description | default('Licensed master electricians serving Salt Lake, Utah, Davis, Tooele & Summit Counties. Residential electrical, panel upgrades, lighting, and emergency repairs. Call 801-885-4521.') }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://osborne-electric.com{{ page.url }}">
  <meta property="og:image" content="https://osborne-electric.com/images/work/new.jpg">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="Osborne Electric & Contracting">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title | default('Osborne Electric & Contracting | Utah\'s Trusted Master Electricians') }}">
  <meta name="twitter:description" content="{{ description | default('Licensed master electricians serving Salt Lake, Utah, Davis, Tooele & Summit Counties. Call 801-885-4521.') }}">

  <!-- Canonical -->
  <link rel="canonical" href="https://osborne-electric.com{{ page.url }}">

  <title>{{ title | default('Osborne Electric & Contracting | Master Electrician Utah') }}</title>

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-C39CXG1F4V"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-C39CXG1F4V');
  </script>

  <!-- First-party pageview beacon -> Trevor's Flight Deck (flight.osborne-electric.com).
       No cookie, no PII, honours Do Not Track, and never blocks the page. GA4
       above stays the deep-analysis tool; this is what the owner's deck reads. -->
  <script>
    (function () {
      if (navigator.doNotTrack === "1" || window.doNotTrack === "1") return;
      var send = function () {
        try {
          fetch("/api/hit", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            keepalive: true,
            body: JSON.stringify({
              p: location.pathname,
              r: document.referrer || null,
              m: window.matchMedia("(max-width: 767px)").matches
            })
          }).catch(function () {});
        } catch (e) {}
      };
      if (document.readyState === "complete") send();
      else window.addEventListener("load", send, { once: true });
    })();
  </script>

  <!-- Fonts: Inter + Syne -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Syne:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">

  {% block schema %}{% endblock %}
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>

  {% include "header.njk" %}

  <main id="main">
    {% block content %}{% endblock %}
  </main>

  {% include "footer.njk" %}

  <!-- Sticky mobile call bar -->
  <a href="tel:801-885-4521" class="mobile-call-bar" aria-label="Call Osborne Electric at 801-885-4521">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    <span>Call Now: (801) 885-4521</span>
  </a>

  <script>
    // Mobile navigation toggle
    document.querySelectorAll('.nav-dropdown > a').forEach(function(el) {
      el.addEventListener('click', function(e) {
        if (window.innerWidth < 1024) {
          e.preventDefault();
          this.parentElement.classList.toggle('active');
        }
      });
    });

    // FAQ toggle (legacy JS-based)
    document.querySelectorAll('.faq-question').forEach(function(el) {
      el.addEventListener('click', function() {
        this.parentElement.classList.toggle('active');
      });
    });

    // GA4 Event: Phone Clicks
    document.querySelectorAll('a[href^="tel:"]').forEach(function(el) {
      el.addEventListener('click', function() {
        var phoneNum = this.href.replace('tel:', '');
        gtag('event', 'phone_click', {
          'event_category': 'contact',
          'event_label': phoneNum,
          'value': 1
        });
        fetch('/api/track', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event: 'phone_click',
            phone: phoneNum,
            page: window.location.pathname,
            timestamp: new Date().toISOString()
          })
        }).catch(function() {});
      });
    });

    // GA4 Event: Form Submissions
    document.querySelectorAll('form').forEach(function(form) {
      form.addEventListener('submit', function() {
        gtag('event', 'form_submission', {
          'event_category': 'contact',
          'event_label': window.location.pathname,
          'value': 1
        });
      });
    });

    // GA4 Event: Email Clicks
    document.querySelectorAll('a[href^="mailto:"]').forEach(function(el) {
      el.addEventListener('click', function() {
        var email = this.href.replace('mailto:', '');
        gtag('event', 'email_click', {
          'event_category': 'contact',
          'event_label': email,
          'value': 1
        });
      });
    });

    // Header scroll effect
    var header = document.querySelector('.header');
    if (header) {
      window.addEventListener('scroll', function() {
        if (window.scrollY > 20) {
          header.classList.add('scrolled');
        } else {
          header.classList.remove('scrolled');
        }
      });
    }
  </script>
  <script src="/js/ga4-events.js"></script>
</body>
</html>
